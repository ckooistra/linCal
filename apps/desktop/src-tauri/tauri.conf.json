{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "universal-calendar",
  "version": "0.1.0",
  "identifier": "org.universalcalendar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universal Calendar",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Fast, local-first calendar for CalDAV, Google and Microsoft",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "publisher": "Universal Calendar contributors",
    "homepage": "https://github.com/ckooistra/linCal",
    "copyright": "© 2026 Universal Calendar contributors. GPL-3.0-or-later.",
    "longDescription": "Universal Calendar shows calendars from CalDAV servers such as Nextcloud, Google Calendar, Microsoft 365 and Outlook.com, and ICS subscriptions in one fast desktop app. Events are kept locally and synchronized in the background, so the calendar stays responsive and works offline.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/universal-calendar.desktop",
        "files": {
          "/usr/share/metainfo/org.universalcalendar.desktop.metainfo.xml": "linux/org.universalcalendar.desktop.metainfo.xml"
        },
        "section": "utils"
      },
      "rpm": {
        "desktopTemplate": "linux/universal-calendar.desktop",
        "files": {
          "/usr/share/metainfo/org.universalcalendar.desktop.metainfo.xml": "linux/org.universalcalendar.desktop.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/org.universalcalendar.desktop.metainfo.xml": "linux/org.universalcalendar.desktop.metainfo.xml"
        }
      }
    }
  },
  "mainBinaryName": "universal-calendar"
}
